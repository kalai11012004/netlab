# Generate with: openssl rand -hex 32. Never expose or commit the generated value.
NETLAB_API_TOKEN=replace-with-at-least-64-hex-characters-generated-randomly
# HTTPS URL of this backend. Must use the same origin as the API and no trailing slash.
NETLAB_PUBLIC_BASE_URL=https://kvm-api.example.com
# Exact, comma-separated browser origins allowed to call the API and open console websockets.
NETLAB_ALLOWED_ORIGINS=https://netlab-studio-hazel.vercel.app,https://kvm-api.example.com
NETLAB_BIND_HOST=127.0.0.1
NETLAB_PORT=8787
NETLAB_LIBVIRT_URI=qemu:///system
NETLAB_VM_ROOT=/var/lib/libvirt/images/netlab-vms
NETLAB_STATE_DIR=/var/lib/netlab/state
NETLAB_CAPTURE_DIR=/var/lib/netlab/captures
NETLAB_IMAGE_DIR=/var/lib/libvirt/images/netlab-base
NETLAB_IMAGE_REGISTRY_FILE=/etc/netlab/image-registry.json
NETLAB_NVRAM_DIR=/var/lib/libvirt/qemu/nvram
NETLAB_OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
NETLAB_OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
NETLAB_OVMF_SECURE_CODE=/usr/share/OVMF/OVMF_CODE_4M.ms.fd
NETLAB_OVMF_SECURE_VARS=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
# Allowlisted libvirt network IDs. These virtual networks must be created and activated by an administrator.
NETLAB_NETWORKS_JSON='{"networks":[{"id":"training-nat","name":"default","label":"Default libvirt NAT network"}]}'
# Only capture interfaces explicitly reviewed by an administrator. Do not expose physical interfaces by default.
NETLAB_CAPTURE_INTERFACES_JSON='{"interfaces":[{"id":"lab-br0","name":"virbr0","label":"Default virtual lab bridge"}]}'
NETLAB_MAX_VMS_PER_LAB=12
NETLAB_MAX_TOTAL_VMS=48
NETLAB_MAX_CAPTURE_SECONDS=60
NETLAB_MAX_CAPTURE_MB=64
# No direct physical NIC passthrough/bridge is enabled by this API profile.
NETLAB_ALLOW_PHYSICAL_BRIDGE=false